{
  "manifest_version": 2,
  "name": "OpenDownload Capture",
  "version": "0.1.1",
  "description": "Captures media requests from one selected tab for OpenDownload.",
  "applications": {
    "gecko": {
      "id": "opendownload-capture@local"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "webRequest",
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["constants.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "OpenDownload Capture",
    "default_popup": "popup.html"
  }
}
